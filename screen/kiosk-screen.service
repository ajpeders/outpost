[Unit]
Description=Living-room idle dashboard (cage + chromium on the Pi HDMI)
After=network-online.target docker.service screen-player.service
Wants=network-online.target

[Service]
Type=simple
User=root
# software rendering (v3d can't do the GL a hw compositor needs)
ExecStart=/home/alex/livingroom-pi/screen/kiosk.sh
# self-heal a crash, but a manual `systemctl stop` (the mpv handoff) stays stopped
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
