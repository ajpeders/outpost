[Unit]
Description=Living-room aerial screensaver (mpv aerials + dashboard overlay on the Pi HDMI)
After=network-online.target docker.service screen-player.service
Wants=network-online.target

Conflicts=kiosk-screen.service mtv-screen.service

[Service]
Type=simple
User=root
# mpv plays the cached Apple aerials on DRM (hardware decode) and composites the
# dashboard over them (headless-chromium PNG -> overlay-add). Alternative to
# kiosk-screen.service (the cage/chromium photo dashboard) — enable one or the
# other. For the screen player's mpv handoff (livestream/alarm) to stop THIS
# instead of the cage kiosk, set SCREEN_KIOSK_SERVICE=aerial-screen on
# screen-player.service.
ExecStart=/usr/bin/python3 %%REPO%%/screen/aerial-mode.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
