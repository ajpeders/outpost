# Copy to .env and edit. Only ATV_ADDRESS is required; every other setting has
# a working default, and blank values switch the matching feature off.
#
# NOTE: this file is read by Docker Compose only. The host-side services in
# screen/ (screen-player, aerial-screen, kiosk-screen) do NOT read it — set
# their variables in the systemd unit instead. See README "On-TV dashboard".

# --- Apple TV (pyatv) ---
# IP of the Apple TV on the LAN. Discover with:
#   avahi-browse -rt _companion-link._tcp   (apt install avahi-utils)
# Required — the appletv service exits on startup without it.
ATV_ADDRESS=
ATV_NAME=Living-Room-ATV
ATV_API_PORT=8010
# Which TV HDMI port the Apple TV is plugged into. Used to switch the TV to it
# over CEC; wrong value = the TV jumps to the wrong input on scenes/handoff.
ATV_HDMI_INPUT=3

# --- CEC (TV set control) ---
CEC_API_PORT=8020
# Kernel CEC device. Must also match the `devices:` entry in docker-compose.yml.
CEC_ADAPTER=/dev/cec0
# Logical address volume commands target: 0 = the TV, 5 = an audio system/soundbar.
CEC_VOLUME_TARGET=0
# Seconds to cache TV power state; each real query re-registers the shared bus.
CEC_STATUS_TTL=45

# --- Hub (the app / UI) ---
HUB_PORT=8080
# Wall-clock zone alarms fire in (e.g. America/Denver, Europe/Berlin).
TZ=UTC

# --- Auto-off (optional) ---
# Stands the TV down if it's left on the idle dashboard overnight.
AUTO_OFF=1
AUTO_OFF_START_HOUR=0
AUTO_OFF_END_HOUR=6
AUTO_OFF_COOLDOWN=3600

# --- Plex (optional) ---
# Point at any reachable Plex Media Server. Leave blank to disable Plex features.
# Example: http://192.168.0.10:32400
PLEX_URL=
PLEX_TOKEN=

# --- Homelab / server stats panel (optional) ---
# SSH target for the dashboard's system-stats line (load/CPU/RAM/disk/temp of a
# box you own). Leave HOMELAB_SSH blank to disable the probe entirely.
# Example: user@192.168.0.10
HOMELAB_SSH=
# Host dir mounted read-only into the hub as /ssh — must hold the key below and a
# known_hosts for HOMELAB_SSH. Defaults to ./data/ssh if unset.
HUB_SSH_DIR=
HOMELAB_SSH_KEY=/ssh/id_ed25519
# Media-pool mount on the homelab box, reported as the disk figure.
HOMELAB_DISK=/mnt/storage

# --- Pi screen player (optional) ---
# Port the host-side screen player listens on; the hub talks to it here.
SCREEN_PORT=9595

# --- Livestream / jetstream (optional) ---
# An HLS manifest the Pi and Apple TV can both reach. "jetstream" is the
# author's own broadcaster — any HLS source works, or leave blank to hide the
# livestream card entirely.
JETSTREAM_URL=
# Human-readable name shown on the livestream button.
JETSTREAM_TITLE=Livestream
# "What's playing now" discovery endpoint the hub polls to label the card.
JETSTREAM_TITLE_URL=
# Skip / next endpoint — the URL a regular browser viewer POSTs to advance the
# queue. Leave blank to hide the Skip button.
# Example shape: http://your-host:PORT/api/control/next
JETSTREAM_SKIP_URL=
# Viewer cookie for authenticated endpoints. If your HLS path bypasses auth on
# the LAN this can stay empty and only the title/skip endpoints break.
JETSTREAM_COOKIE=
