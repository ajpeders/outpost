# --- Apple TV (pyatv) ---
# IP of the Apple TV on the LAN (avahi-browse -rt _companion-link._tcp)
ATV_ADDRESS=192.168.0.39
ATV_NAME=Living-Room-ATV
ATV_API_PORT=8010

# --- CEC ---
CEC_API_PORT=8020

# --- Hub (the app / UI) ---
HUB_PORT=8080

# --- Plex (optional) ---
# Point at any reachable Plex Media Server. Leave blank to disable Plex features.
# Example: http://192.168.0.10:32400
PLEX_URL=
PLEX_TOKEN=

# --- Homelab / server stats panel (optional) ---
# SSH target for the dashboard's system-stats line (load/CPU/RAM/disk/temp of a
# box you own). Leave HOMELAB_SSH blank to disable the probe entirely.
# Example: user@192.168.0.10
HOMELAB_SSH=
# Host dir mounted read-only into the hub as /ssh — must hold the key below and a
# known_hosts for HOMELAB_SSH. Defaults to ./data/ssh if unset.
HUB_SSH_DIR=
HOMELAB_SSH_KEY=/ssh/id_ed25519
# Media-pool mount on the homelab box, reported as the disk figure.
HOMELAB_DISK=/mnt/storage

# --- Pi screen player (optional) ---
# Root of the local media library the file/shuffle sources walk.
SCREEN_MEDIA_ROOT=/mnt/share/media

# --- Jetstream (optional) ---
# HLS manifest URL (what mpv plays) — must be reachable by Apple TV, auth in URL if any.
JETSTREAM_URL=
# "What's playing now" discovery endpoint the hub polls to label the livestream card.
JETSTREAM_TITLE_URL=
# Skip / next endpoint on the jetstream viewer API — the URL a regular browser viewer
# POSTs to advance the queue. Leave blank to disable the Skip button.
# Auth is the lt= viewer cookie (JETSTREAM_COOKIE), same as the title discovery request.
# Example shape (adjust to match your jetstream): http://homelab:PORT/api/control/next
JETSTREAM_SKIP_URL=
# Viewer cookie for jetstream's authenticated endpoints. If your HLS path bypasses auth
# on the LAN, JETSTREAM_COOKIE can stay empty and only the title/skip endpoints break.
JETSTREAM_COOKIE=

TZ=UTC
