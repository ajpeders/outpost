# --- Apple TV (pyatv) ---
# IP of the Apple TV on the LAN (avahi-browse -rt _companion-link._tcp)
ATV_ADDRESS=192.168.0.39
ATV_NAME=Living-Room-ATV
ATV_API_PORT=8010

# --- CEC ---
CEC_API_PORT=8020

# --- Hub (the app / UI) ---
HUB_PORT=8080

# --- Plex (optional) ---
# Example: http://192.168.0.10:32400
PLEX_URL=
PLEX_TOKEN=

# --- Jetstream (optional) ---
JETSTREAM_URL=
JETSTREAM_TITLE_URL=

TZ=UTC
